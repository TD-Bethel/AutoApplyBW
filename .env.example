# ---- Copy this file to .env and fill in the values ----

# Secret used to sign session cookies. Use a long random string, e.g. from:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left unset/placeholder, the app generates a temporary random key on each
# start (safe, but everyone is logged out on restart).
SECRET_KEY=

# Set to 1 when serving over HTTPS (e.g. on Fly.io) so session cookies are
# only ever sent over secure connections.
COOKIE_SECURE=0

# Claude API key (you, the owner, provide ONE key for all users).
# Get it from https://console.anthropic.com/ . Leave blank to use the
# free rule-based fallback (no AI rewriting).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# The first admin account. Created automatically on first run.
ADMIN_EMAIL=theberatsatsi23@gmail.com
ADMIN_PASSWORD=change-this-admin-password

# Where the SQLite database lives (default is fine).
DATABASE_PATH=instance/autoapply.db

# System / platform email. Used for two things:
#   1. password-reset links and other transactional notices (sent FROM the
#      platform's own mailbox), and
#   2. a fallback sender if a user has not configured their own email.
# For Gmail: host = smtp.gmail.com, port = 587, user = your full Gmail address,
# password = a 16-char Google "App Password" (NOT your normal password; create
# one at https://myaccount.google.com/apppasswords with 2-Step Verification on).
# Leave blank to disable system email (password resets will then be unavailable).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=AutoApply BW

# Max emails a user may send per hour (anti-spam / deliverability protection).
SEND_RATE_PER_HOUR=30

# Optional alternative AI provider (OpenAI-compatible). Used when
# ANTHROPIC_API_KEY is empty. Get a key at platform.deepseek.com.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- Card payments ----------------------------------------------------------
# Users pay by Visa/Mastercard through a hosted checkout; a verified payment
# activates the account for SUBSCRIPTION_DAYS. Leave the chosen provider's keys
# blank to disable card billing (the page shows "not available" and you activate
# users manually from /admin).
#
# Which gateway to use: "dpo" (DPO Pay — Botswana default) or "flutterwave".
PAYMENT_PROVIDER=dpo

# --- DPO Pay (Direct Pay Online) ---
# Register at https://dpogroup.com to get your CompanyToken + ServiceType (DPO
# gives you TEST credentials first, then LIVE once approved). Fill them in below.
# NOTE: DPO's old public sandbox token (9F416C11-...) is deactivated ("Company is
# not active"), so you must use your own. Also: DPO's WAF rejects checkout when
# the RedirectURL is localhost — test via your https domain (Render/tunnel), not
# http://127.0.0.1. DPO redirects back to https://YOUR-DOMAIN/billing/callback.
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=

# --- Flutterwave (alternative; only used when PAYMENT_PROVIDER=flutterwave) ---
# Keys at https://dashboard.flutterwave.com (Settings -> API Keys). Use TEST
# keys (FLWSECK_TEST-...) while trying it out, LIVE keys to take money.
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
# The "Secret hash" from Settings -> Webhooks; Flutterwave sends it in the
# `verif-hash` header and the webhook is rejected unless it matches. Point the
# webhook URL at https://YOUR-DOMAIN/billing/webhook.
FLW_WEBHOOK_HASH=

# Price and access length granted by one subscription payment.
SUBSCRIPTION_PRICE_BWP=50
SUBSCRIPTION_CURRENCY=BWP
SUBSCRIPTION_DAYS=30
